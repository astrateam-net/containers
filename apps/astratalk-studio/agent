#!/usr/bin/env bash
set -euo pipefail

NEWKEY=/tmp/agent-assets/public.pem
F=/usr/src/app/backend/server/services/license/utils/public-key.ts
ORIG_ANCHOR='6L90HBMIeiEUkLw85aRx'
OUR_ANCHOR='3IqSRU6W9TSirwmOhPwQ'

[ -f "$F" ] || { echo "astratalk-studio: target not found ($F)" >&2; exit 1; }
grep -qF "$ORIG_ANCHOR" "$F" || { echo "astratalk-studio: anchor gone ($F)" >&2; exit 1; }

node -e '
const fs = require("fs");
const [f, k] = [process.argv[1], process.argv[2]];
const pub = fs.readFileSync(k, "utf8").trim();
let s = fs.readFileSync(f, "utf8");
const re = /`-----BEGIN PUBLIC KEY-----[\s\S]*?-----END PUBLIC KEY-----`/;
if (!re.test(s)) { console.error("astratalk-studio: template not found"); process.exit(1); }
fs.writeFileSync(f, s.replace(re, "`" + pub + "`"));
' "$F" "$NEWKEY"

grep -qF "$OUR_ANCHOR" "$F" || { echo "astratalk-studio: verify failed" >&2; exit 1; }
