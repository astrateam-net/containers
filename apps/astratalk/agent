#!/usr/bin/env bash
set -euo pipefail

NEWKEY=/tmp/agent-assets/public.pem
ORIG_ANCHOR='6L90HBMIeiEUkLw85aRx'
OUR_ANCHOR='3IqSRU6W9TSirwmOhPwQ'

F=$(python -c 'import rasa.utils.licensing as m, os; print(os.path.realpath(m.__file__))')
[ -n "$F" ] || { echo "astratalk: target not found" >&2; exit 1; }
grep -qF "$ORIG_ANCHOR" "$F" || { echo "astratalk: anchor gone ($F)" >&2; exit 1; }

python - "$F" "$NEWKEY" <<'PY'
import re, sys, pathlib
f, k = sys.argv[1], sys.argv[2]
pub = pathlib.Path(k).read_text().strip()
src = pathlib.Path(f).read_text()
new, n = re.subn(
    r'PUBLIC_KEY = """-----BEGIN PUBLIC KEY-----.*?-----END PUBLIC KEY-----"""',
    'PUBLIC_KEY = """' + pub + '"""', src, flags=re.S)
assert n == 1
pathlib.Path(f).write_text(new)
PY

grep -qF "$OUR_ANCHOR" "$F" || { echo "astratalk: verify failed" >&2; exit 1; }
