#!/usr/bin/env bash
# Swap the embedded license public key inside io.cloudbeaver.product.ee and drop
# the vendor jar signature. Fail loud if the anchor moves on a version bump.
set -euo pipefail

PLUGINS=/opt/cloudbeaver/server/plugins
NEWKEY=/tmp/agent-assets/public.key
ORIG_ANCHOR='lAiyH9ghPpqATx/FtCV2o5y6UKDFR'
OUR_ANCHOR='1WAfZom4ZlkyIYH5PLpScutjKM4L0h2N'

jar=$(ls "$PLUGINS"/io.cloudbeaver.product.ee_*.jar 2>/dev/null | head -n1)
[ -n "$jar" ] || { echo "astradb: product.ee jar not found" >&2; exit 1; }

work=$(mktemp -d)
( cd "$work" && jar xf "$jar" )

key="$work/keys/cloudbeaver-ee-public.key"
grep -qF "$ORIG_ANCHOR" "$key" || { echo "astradb: original key anchor gone ($key)" >&2; exit 1; }

cp "$NEWKEY" "$key"
rm -f "$work"/META-INF/DBEAVER.SF "$work"/META-INF/DBEAVER.RSA
# keep only the main manifest section (drop per-entry signature digests)
awk 'BEGIN{p=1} /^$/{p=0} p{print}' "$work/META-INF/MANIFEST.MF" > "$work/META-INF/MANIFEST.tmp"
mv "$work/META-INF/MANIFEST.tmp" "$work/META-INF/MANIFEST.MF"

( cd "$work" && jar cfm "$jar" META-INF/MANIFEST.MF . )
rm -rf "$work"

# fail loud: our key must be present after the swap
verify=$(mktemp -d)
( cd "$verify" && jar xf "$jar" keys/cloudbeaver-ee-public.key )
grep -qF "$OUR_ANCHOR" "$verify/keys/cloudbeaver-ee-public.key" \
  || { echo "astradb: our key not present after swap" >&2; exit 1; }
rm -rf "$verify"

echo "astradb: license key swapped in $(basename "$jar")"
